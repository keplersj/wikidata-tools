{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "mutate": ["packages/engine/src/**/*.ts", "!packages/engine/src/qs-sim.ts", "!packages/engine/src/index.ts", "!packages/engine/src/types.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 85, "low": 70, "break": null },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["apps/web/dist", "reports", "node_modules/.cache"]
}
